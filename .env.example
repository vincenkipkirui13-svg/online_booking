# Database: use a managed PostgreSQL database for production (e.g. Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Create a long random secret before enabling admin authentication
AUTH_SECRET="replace-with-a-long-random-secret"

# Safaricom Daraja (keep all credentials server-side)
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_SECRET=""

# Card payments provider credentials (server-side only)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Public website URL used for payment callbacks and redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"
