# Database: use a managed PostgreSQL database for production (e.g. Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Create a long random secret before enabling admin authentication
AUTH_SECRET="replace-with-a-long-random-secret"

# Manual M-Pesa collection: choose PAYBILL or TILL and fill only the matching number
MPESA_PAYMENT_TYPE="PAYBILL"
MPESA_PAYBILL_NUMBER=""
MPESA_TILL_NUMBER=""
MPESA_ACCOUNT_NAME=""

# Public website URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
